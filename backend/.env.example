# Copiar a backend/.env. No versionar .env ni escribir secretos en Angular.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=autoscan_motors
DB_USER=
DB_PASSWORD=

# Alternativa: URL mysql+pymysql://usuario:password@host:3306/autoscan_motors.
# Si se utiliza, codificar los caracteres especiales de sus credenciales.
# Con DB_* la aplicación realiza esa codificación automáticamente.
# DATABASE_URL=
DB_CONNECT_TIMEOUT=5
DB_POOL_RECYCLE=1800

# Se configurará al implementar JWT en la fase 3; no tiene un valor por defecto.
JWT_SECRET=

# Correo: se conectará al implementar facturas y SMTP. Usar credenciales propias.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=AutoScan Motors
SMTP_USE_TLS=true

# Orígenes explícitos separados por coma. No se admite * con credenciales.
CORS_ORIGINS=http://localhost:4200

# Compatibilidad temporal del evaluador antiguo durante la migración.
# No son necesarias para /api/health ni para inspeccionar MySQL.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Si es "true", el endpoint /api/evaluate exige un Bearer token de Firebase válido.
# Conservar true hasta disponer del reemplazo JWT probado.
REQUIRE_AUTH=true

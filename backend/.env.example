# Orígenes permitidos para CORS (separados por coma). El dev-server de Angular usa 4200.
CORS_ORIGINS=http://localhost:4200

# Ruta al JSON de la cuenta de servicio de Firebase, usada por firebase-admin para
# verificar los ID tokens que envía el frontend. Se descarga desde
# Firebase Console > Configuración del proyecto > Cuentas de servicio.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Si es "true", el endpoint /api/evaluate exige un Bearer token de Firebase válido.
# Ponlo en "false" para probar la API sin login mientras desarrollas.
REQUIRE_AUTH=true
